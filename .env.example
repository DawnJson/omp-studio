# omp-studio 开发和测试用的凭据模板。复制成 .env 再填值；.env 不要提交进 git。
# 启动 omp 子进程时，.env 里的变量作为环境变量传进去（见 docs/architecture/testing.md「隔离用户数据、不留残留」）。
# 变量名必须是 omp 认的名字，完整列表见 omp 文档 environment-variables.md。
# 只填你要用的那一家，其余留空或删掉。

# 测试用的模型，启动 omp 时作为 --model 的值。
# 格式和 omp 的 --model 一样：<provider>/<模型 id>，比如 openai/gpt-5.2。选能跑通流程的最便宜的模型。
STUDIO_TEST_MODEL=

# Anthropic。走中转时把 ANTHROPIC_BASE_URL 设成中转地址。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# OpenAI 及 OpenAI 兼容接口。走中转时设 OPENAI_BASE_URL。
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Google Gemini
GEMINI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=
