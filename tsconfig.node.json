{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.node.tsbuildinfo",
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/main",
    "src/preload",
    "src/shared",
    "src/renderer/src/markdown/parse.ts",
    "src/renderer/src/markdown/math.ts",
    "src/renderer/src/markdown/render.ts",
    "src/renderer/src/markdown/markdown-static.ts",
    "src/renderer/src/features/conversation/model.ts",
    "src/renderer/src/features/conversation/tool-info.ts",
    "src/renderer/src/features/conversation/diffstat.ts",
    "src/renderer/src/features/conversation/tool-view.ts",
    "src/renderer/src/features/lanes/lane-model.ts",
    "src/renderer/src/features/btw/btw-view.ts",
    "src/renderer/src/features/goal/goal-model.ts",
    "src/renderer/src/features/review/explain.ts",
    "src/renderer/src/features/composer/model-groups.ts",
    "src/renderer/src/features/composer/file-complete.ts",
    "src/renderer/src/features/composer/input-history.ts",
    "src/renderer/src/features/composer/send-logic.ts",
    "src/renderer/src/features/composer/slash-match.ts",
    "src/renderer/src/features/composer/slash-guard.ts",
    "src/renderer/src/features/composer/studio-slash.ts",
    "src/renderer/src/features/composer/stop-outcome.ts",
    "src/renderer/src/features/composer/thinking-levels.ts",
    "src/renderer/src/features/file-preview/tree-model.ts",
    "src/renderer/src/features/composer/usage-format.ts",
    "src/renderer/src/features/composer/speed-limit-format.ts",
    "src/renderer/src/features/composer/context-rows.ts",
    "src/renderer/src/features/composer/dot-sphere.ts",
    "src/renderer/src/features/dialogs/approval-labels.ts",
    "src/renderer/src/features/dialogs/ask-draft-store.ts",
    "src/renderer/src/features/dialogs/gate-timer.ts",
    "src/renderer/src/features/dialogs/gate-preview.ts",
    "src/renderer/src/features/tsp/keys.ts",
    "src/renderer/src/features/tsp/ansi.ts",
    "src/renderer/src/features/tsp/diff-parse.ts",
    "src/renderer/src/features/tsp/fmt.ts",
    "src/renderer/src/features/tsp/shell-tokens.ts",
    "src/renderer/src/features/tsp/span-tokens.ts",
    "src/renderer/src/features/tsp/tsp-sync.ts",
    "src/renderer/src/features/tsp/turn-cost.ts",
    "src/renderer/src/features/tsp/turn-footer.ts",
    "src/renderer/src/features/tsp/interactive/text-model.ts",
    "src/renderer/src/features/tsp/interactive/picker-model.ts",
    "src/renderer/src/features/tsp/interactive/prefs-model.ts",
    "src/renderer/src/store/create-store.ts",
    "src/renderer/src/store/transcript-sync.ts",
    "scripts",
    "test",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
