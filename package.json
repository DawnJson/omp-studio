{
  "name": "omp-studio",
  "version": "0.4.29",
  "private": true,
  "description": "oh-my-pi (omp) 的桌面端",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pack": "electron-vite build && electron-builder --win dir --publish never",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "rpc:update-wire": "node scripts/update-rpc-wire.ts",
    "icons": "node scripts/make-icons.ts",
    "dist": "electron-vite build && electron-builder --win nsis --publish never && node scripts/check-package.ts release/win-unpacked/resources/app.asar win32-x64",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64 --publish never && node scripts/check-package.ts release/mac-arm64/omp-studio.app/Contents/Resources/app.asar darwin-arm64",
    "release": "node scripts/release.ts",
    "postinstall": "node scripts/fix-node-pty.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "katex": "0.19.0",
    "markdown-it": "15.0.3",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.5.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "koffi": "3.3.3",
    "node-pty": "1.1.0",
    "yaml": "2.9.1"
  }
}
